{
    "configurations": [
        {
            "name": "Win64",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/vendor/imgui",
                "${workspaceFolder}/vendor/imgui/backends",
                "${workspaceFolder}/vendor/minhook/include"
            ],
            "defines": [
                "UNICODE",
                "_UNICODE",
                "WIN32_LEAN_AND_MEAN",
                "NOMINMAX",
                "IMGUI_DISABLE_OBSOLETE_FUNCTIONS",
                "IMGUI_DEFINE_MATH_OPERATORS",
                "IL2CPP_BASE_VERSION=\"dev\""
            ],
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-msvc-x64"
        }
    ],
    "version": 4
}
