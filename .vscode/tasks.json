{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Release",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/build.ps1",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/build.ps1 -Debug",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/build.ps1 -Clean",
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}
